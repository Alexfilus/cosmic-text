+fn is_cursive_script(script: Script) -> bool {
+    matches!(
+        script,
+        Script::Arabic
+            | Script::Hanifi_Rohingya
+            | Script::Mandaic
+            | Script::Mongolian
+            | Script::Nko
+            | Script::Phags_Pa
+            | Script::Syriac
+    )
